// Windows application manifest and version resource.
// The manifest is inlined as resource bytes: windres' handling of a referenced
// file name breaks when the source tree path contains spaces.
#pragma code_page(65001)
#include <winver.h>

1 RT_MANIFEST
BEGIN
    "<?xml version=""1.0"" encoding=""UTF-8"" standalone=""yes""?>"
    "<assembly xmlns=""urn:schemas-microsoft-com:asm.v1"" manifestVersion=""1.0"">"
    "  <assemblyIdentity type=""win32"" name=""NebulousLinerHullCustomizer.NLHC"""
    "                    version=""@NLHC_MANIFEST_VERSION@"" processorArchitecture=""amd64""/>"
    "  <trustInfo xmlns=""urn:schemas-microsoft-com:asm.v3"">"
    "    <security>"
    "      <requestedPrivileges>"
    "        <requestedExecutionLevel level=""asInvoker"" uiAccess=""false""/>"
    "      </requestedPrivileges>"
    "    </security>"
    "  </trustInfo>"
    "  <compatibility xmlns=""urn:schemas-microsoft-com:compatibility.v1"">"
    "    <application>"
    "      <supportedOS Id=""{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}""/>"
    "      <supportedOS Id=""{1f676c76-80e1-4239-95bb-83d0f6d0da78}""/>"
    "      <supportedOS Id=""{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}""/>"
    "      <supportedOS Id=""{35138b9a-5d96-4fbd-8e2d-a2440225f93a}""/>"
    "    </application>"
    "  </compatibility>"
    "  <application xmlns=""urn:schemas-microsoft-com:asm.v3"">"
    "    <windowsSettings>"
    "      <dpiAware xmlns=""http://schemas.microsoft.com/SMI/2005/WindowsSettings"">true/pm</dpiAware>"
    "      <dpiAwareness xmlns=""http://schemas.microsoft.com/SMI/2016/WindowsSettings"">permonitorv2,permonitor</dpiAwareness>"
    "      <longPathAware xmlns=""http://schemas.microsoft.com/SMI/2016/WindowsSettings"">true</longPathAware>"
    "    </windowsSettings>"
    "  </application>"
    "</assembly>"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION @NLHC_VERSION_COMMA@
PRODUCTVERSION @NLHC_VERSION_COMMA@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Nebulous Liner Hull Customizer\0"
            VALUE "FileDescription", "Nebulous Liner Hull Customizer\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
            VALUE "InternalName", "NLHC\0"
            VALUE "LegalCopyright", "Not affiliated with Nebulous: Fleet Command\0"
            VALUE "OriginalFilename", "NLHC.exe\0"
            VALUE "ProductName", "Nebulous Liner Hull Customizer\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
